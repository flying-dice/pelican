{
    "name": "pelican",
    "version": "0.0.7",
    "description": "",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "tstl --project tsconfig.tstl.json",
        "build:docs": "npm run build && npx typedoc --entryPointStrategy Expand types",
        "test": "lua tests/index.lua",
        "test:e2e": "concurrently --kill-others \"lua server/index.lua\" \"vitest tests-e2e\"",
        "test:load": "k6 run script.http.js --vus 10 --duration 30s > script.http.results",
        "serve": "lua server/index.lua",
        "fmt": "prettier --write \"**/*.{ts,js}\" \"**/*.md\" && node fmt.js"
    },
    "author": "Flying Dice",
    "license": "ISC",
    "devDependencies": {
        "axios": "^1.10.0",
        "concurrently": "^9.2.0",
        "lua-fmt": "^2.6.0",
        "lua-types": "^2.13.1",
        "prettier": "^3.5.3",
        "typedoc": "^0.28.5",
        "typescript": "5.8.2",
        "typescript-to-lua": "1.37.1",
        "vitest": "^3.2.4"
    }
}
